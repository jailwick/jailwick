#!/bin/sh
# jailwick-proxy runs Squid for one sandbox and opens it to the whole internet on request.
#
#   jailwick-proxy run            the container's main process: Squid, plus the open-window timer
#   jailwick-proxy open SECONDS   open to every destination for SECONDS (0: until closed)
#   jailwick-proxy status         "open|closed <until> <now>" (unix seconds; until 0: no end)
#
# The open state lives only in tmpfs. A restart, a crash or the end of the window always brings
# the proxy back to the allowlist (fail closed), and leaving `run` ends every open tunnel.
# Closing early is a container restart, done by the host.
set -eu

STATE=${JAILWICK_PROXY_STATE:-/tmp}
ACL=$STATE/open-acl     # source addresses allowed everywhere; empty: nobody
UNTIL=$STATE/open-until # when the window ends (unix seconds); 0: until closed
CONF=${JAILWICK_SQUID_CONF:-/etc/squid/squid.conf}

now() { date +%s; }

# put FILE CONTENT: replace a file atomically, so readers never see half of it.
put() { printf '%s\n' "$2" > "$1.new" && mv "$1.new" "$1"; }

run() {
	: > "$ACL"
	put "$UNTIL" 0
	squid -N -f "$CONF" &
	pid=$!
	trap 'kill -TERM "$pid" 2>/dev/null; wait "$pid" || true; exit 0' TERM INT
	while kill -0 "$pid" 2>/dev/null; do
		if [ -s "$ACL" ]; then
			until=$(cat "$UNTIL" 2>/dev/null || echo 1)
			if [ "$until" -gt 0 ] && [ "$(now)" -ge "$until" ]; then
				echo "jailwick-proxy: the open window ended; back to the allowlist" >&2
				kill -TERM "$pid" 2>/dev/null || true
				wait "$pid" || true
				exit 0 # the container restarts with an empty tmpfs
			fi
		fi
		sleep 2
	done
	wait "$pid" # Squid is gone: leave with its status, the container restarts closed
}

open() {
	case ${1:-} in
	'' | *[!0-9]*)
		echo "usage: jailwick-proxy open SECONDS (0: until closed)" >&2
		exit 2
		;;
	esac
	# Wait for `run` to be up, so its start can't wipe what is written here.
	i=0
	until nc -z 127.0.0.1 3128 2>/dev/null; do
		i=$((i + 1))
		if [ "$i" -ge 75 ]; then
			echo "jailwick-proxy: the proxy isn't listening" >&2
			exit 1
		fi
		sleep 0.2
	done
	if [ "$1" -eq 0 ]; then until=0; else until=$(($(now) + $1)); fi
	put "$UNTIL" "$until" # the end first: the timer never sees an opening without one
	put "$ACL" "$(printf '0.0.0.0/0\n::/0')"
	squid -k reconfigure -f "$CONF"
	status
}

status() {
	if [ -s "$ACL" ]; then
		echo "open $(cat "$UNTIL") $(now)"
	else
		echo "closed 0 $(now)"
	fi
}

case ${1:-} in
run) run ;;
open) open "${2:-}" ;;
status) status ;;
*)
	echo "usage: jailwick-proxy run | open SECONDS | status" >&2
	exit 2
	;;
esac
