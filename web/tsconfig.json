{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["svelte"],
    "paths": { "styled-system/*": ["./styled-system/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "styled-system/**/*.mjs", "styled-system/**/*.d.ts"]
}
